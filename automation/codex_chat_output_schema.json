{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workout Coach Chat Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["assistantText", "actionPlan"],
  "properties": {
    "assistantText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "actionPlan": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/definitions/actionPlan" }
      ]
    }
  },
  "definitions": {
    "exerciseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "targetSets", "repRange"],
      "properties": {
        "exerciseId": { "type": "string", "minLength": 1 },
        "targetSets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repRange": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "sessionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exercises"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/exerciseSpec" }
        }
      }
    },
    "replacementSessionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionTemplateId", "name", "exercises"],
      "properties": {
        "sessionTemplateId": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/exerciseSpec" }
        }
      }
    },
    "swapActiveExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "fromExerciseId",
        "toExerciseId",
        "targetSets",
        "repRange"
      ],
      "properties": {
        "type": { "type": "string", "const": "swap_active_exercise" },
        "sessionId": { "type": "string", "minLength": 1 },
        "fromExerciseId": { "type": "string", "minLength": 1 },
        "toExerciseId": { "type": "string", "minLength": 1 },
        "targetSets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repRange": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "addActiveExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "exerciseId",
        "position",
        "targetSets",
        "repRange"
      ],
      "properties": {
        "type": { "type": "string", "const": "add_active_exercise" },
        "sessionId": { "type": "string", "minLength": 1 },
        "exerciseId": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "targetSets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repRange": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "updateActiveExerciseTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "exerciseId",
        "targetSets",
        "repRange"
      ],
      "properties": {
        "type": { "type": "string", "const": "update_active_exercise_targets" },
        "sessionId": { "type": "string", "minLength": 1 },
        "exerciseId": { "type": "string", "minLength": 1 },
        "targetSets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repRange": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "createOneTimeWorkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "exercises"],
      "properties": {
        "type": { "type": "string", "const": "create_one_time_workout" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/exerciseSpec" }
        }
      }
    },
    "createSessionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "programId", "name", "exercises"],
      "properties": {
        "type": { "type": "string", "const": "create_session_template" },
        "programId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/exerciseSpec" }
        }
      }
    },
    "createProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "sessions"],
      "properties": {
        "type": { "type": "string", "const": "create_program" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/sessionSpec" }
        }
      }
    },
    "renameProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "programId", "name"],
      "properties": {
        "type": { "type": "string", "const": "rename_program" },
        "programId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "replaceProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "programId", "name", "sessions"],
      "properties": {
        "type": { "type": "string", "const": "replace_program" },
        "programId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/replacementSessionSpec" }
        }
      }
    },
    "archiveProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "programId"],
      "properties": {
        "type": { "type": "string", "const": "archive_program" },
        "programId": { "type": "string", "minLength": 1 }
      }
    },
    "replaceSessionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionTemplateId", "name", "exercises"],
      "properties": {
        "type": { "type": "string", "const": "replace_session_template" },
        "sessionTemplateId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/exerciseSpec" }
        }
      }
    },
    "deleteSessionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sessionTemplateId"],
      "properties": {
        "type": { "type": "string", "const": "delete_session_template" },
        "sessionTemplateId": { "type": "string", "minLength": 1 }
      }
    },
    "createCustomExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "primaryMuscle",
        "secondaryMuscles",
        "notes",
        "defaultRestSeconds"
      ],
      "properties": {
        "type": { "type": "string", "const": "create_custom_exercise" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "primaryMuscle": {
          "type": "string",
          "enum": [
            "chest",
            "back",
            "shoulders",
            "biceps",
            "triceps",
            "forearms",
            "quads",
            "hamstrings",
            "glutes",
            "calves",
            "abs",
            "traps"
          ]
        },
        "secondaryMuscles": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "string",
            "enum": [
              "chest",
              "back",
              "shoulders",
              "biceps",
              "triceps",
              "forearms",
              "quads",
              "hamstrings",
              "glutes",
              "calves",
              "abs",
              "traps"
            ]
          }
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "defaultRestSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "saveAiNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": { "type": "string", "const": "save_ai_note" },
        "body": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "action": {
      "anyOf": [
        { "$ref": "#/definitions/swapActiveExercise" },
        { "$ref": "#/definitions/addActiveExercise" },
        { "$ref": "#/definitions/updateActiveExerciseTargets" },
        { "$ref": "#/definitions/createOneTimeWorkout" },
        { "$ref": "#/definitions/createSessionTemplate" },
        { "$ref": "#/definitions/createProgram" },
        { "$ref": "#/definitions/renameProgram" },
        { "$ref": "#/definitions/replaceProgram" },
        { "$ref": "#/definitions/archiveProgram" },
        { "$ref": "#/definitions/replaceSessionTemplate" },
        { "$ref": "#/definitions/deleteSessionTemplate" },
        { "$ref": "#/definitions/createCustomExercise" },
        { "$ref": "#/definitions/saveAiNote" }
      ]
    },
    "actionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "scope", "actions"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "scope": {
          "type": "string",
          "enum": [
            "active_workout",
            "one_time_workout",
            "program",
            "exercise_library",
            "ai_memory"
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/action" }
        }
      }
    }
  }
}
