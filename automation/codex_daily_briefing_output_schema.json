{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["briefing", "memory"],
  "properties": {
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "mode",
        "sections",
        "source",
        "model",
        "snapshotUpdatedAt",
        "inputSummary"
      ],
      "properties": {
        "headline": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["push", "normal", "light", "deload"]
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "todaysCall",
            "why",
            "recoveryStatus",
            "ouraRecovery",
            "trainingTrend",
            "watchOuts"
          ],
          "properties": {
            "todaysCall": { "type": "string" },
            "why": {
              "type": "array",
              "items": { "type": "string" }
            },
            "recoveryStatus": {
              "type": "string",
              "enum": ["fresh", "stale", "unavailable"]
            },
            "ouraRecovery": { "type": "string" },
            "trainingTrend": { "type": "string" },
            "watchOuts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "source": { "type": "string" },
        "model": { "type": "string" },
        "snapshotUpdatedAt": { "type": "number" },
        "inputSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotUpdatedAt",
            "latestCompletedWorkoutAt",
            "workoutCount",
            "loggedSetCount",
            "usedOura",
            "memoryItemCount",
            "newMemoryItemCount"
          ],
          "properties": {
            "snapshotUpdatedAt": { "type": "number" },
            "latestCompletedWorkoutAt": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            },
            "workoutCount": { "type": "integer" },
            "loggedSetCount": { "type": "integer" },
            "usedOura": { "type": "boolean" },
            "memoryItemCount": { "type": "integer" },
            "newMemoryItemCount": { "type": "integer" }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "newItems"],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currentContext",
            "paused",
            "windowStartedAt",
            "fourMonthStartedAt",
            "sourceSnapshotUpdatedAt"
          ],
          "properties": {
            "currentContext": { "type": "string" },
            "paused": { "type": "boolean" },
            "windowStartedAt": { "type": "number" },
            "fourMonthStartedAt": { "type": "number" },
            "sourceSnapshotUpdatedAt": { "type": "number" }
          }
        },
        "newItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "memoryType",
              "periodStartAt",
              "periodEndAt",
              "sourceWorkoutSessionId",
              "bullets",
              "sourceSessionIds",
              "sourceNoteIds",
              "sourceSummaryIds",
              "model",
              "createdAt",
              "updatedAt",
              "snapshotUpdatedAt"
            ],
            "properties": {
              "id": { "type": "string" },
              "memoryType": {
                "type": "string",
                "enum": ["workout", "two_week", "four_month"]
              },
              "periodStartAt": { "type": "number" },
              "periodEndAt": { "type": "number" },
              "sourceWorkoutSessionId": {
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "bullets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sourceSessionIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sourceNoteIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sourceSummaryIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "model": { "type": "string" },
              "createdAt": { "type": "number" },
              "updatedAt": { "type": "number" },
              "snapshotUpdatedAt": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
